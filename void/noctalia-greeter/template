# Template file for 'noctalia-greeter'
pkgname=noctalia-greeter
version=1.7.0
revision=1
build_style=meson
build_helper=qemu
hostmakedepends="pkg-config wayland-devel"
makedepends="cairo-devel fontconfig-devel freetype-devel glib-devel json-c++
 libepoxy-devel libglvnd-devel libinput-devel libjxl-devel librsvg-devel
 libwebp-devel libxkbcommon-devel libxml2-devel MesaLib-devel pango-devel stb
 tomlplusplus-devel wayland-devel wayland-protocols wlroots0.20-devel"
depends="bash dbus greetd"
checkdepends="mesa-dri"
short_desc="Minimal greetd login greeter with a bundled wlroots compositor"
maintainer="Haris <plavpxl@proton.me>"
license="MIT"
homepage="https://github.com/noctalia-dev/noctalia-greeter"
changelog="https://github.com/noctalia-dev/noctalia-greeter/releases"
distfiles="https://github.com/noctalia-dev/noctalia-greeter/archive/refs/tags/v${version}.tar.gz"
checksum=5b092784c0147bb6739efc2e8146d2d07e3572a59d7a370e93092f9f56d4fcc8
make_dirs="/var/lib/noctalia-greeter 0750 _greeter _greeter"

post_patch() {
	# void greetd uses _greeter rather than upstream's greeter account.
	vsed -i 's/0750 greeter greeter/0750 _greeter _greeter/' data/tmpfiles.d/noctalia-greeter.conf
}

post_install() {
	vlicense LICENSE
	vdoc README.md
	vdoc PACKAGING.md
}
